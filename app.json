{
  "expo": {
    "name": "Lamma",
    "slug": "lamma",
    "version": "1.0.0",
    "scheme": "lamma",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FDFAF1",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "bundleIdentifier": "com.anventureslabs.lamma",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "com.anventureslabs.lamma",
      "adaptiveIcon": {
        "backgroundColor": "#38146C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-localization",
        {
          "supportsRTL": true
        }
      ],
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "PORTRAIT_UP"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#38146C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 288
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "web": {
      "output": "single",
      "bundler": "metro"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5a9efbbe-0096-4f3f-a3cf-0d28780eb0bf"
      }
    },
    "owner": "mnassef"
  }
}
